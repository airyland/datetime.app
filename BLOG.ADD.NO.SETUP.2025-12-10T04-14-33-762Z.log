'<hr>');\n    97→\n    98→  // Process lists properly\n    99→  const lines = html.split('\\n');\n   100→  let result = [];\n   101→  let inList = false;\n   102→  let listType = '';\n   103→\n   104→  for (let i = 0; i < lines.length; i++) {\n   105→    let line = lines[i];\n   106→\n   107→    // Unordered list\n   108→    if (line.match(/^[\\*\\-] (.+)$/)) {\n   109→      const content = line.replace(/^[\\*\\-] (.+)$/, '$1');\n   110→      if (!inList || listType !== 'ul') {\n   111→        if (inList) result.push('</' + listType + '>');\n   112→        result.push('<ul>');\n   113→        inList = true;\n   114→        listType = 'ul';\n   115→      }\n   116→      result.push('<li>' + content + '</li>');\n   117→    }\n   118→    // Ordered list\n   119→    else if (line.match(/^\\d+\\. (.+)$/)) {\n   120→      const content = line.replace(/^\\d+\\. (.+)$/, '$1');\n   121→      if (!inList || listType !== 'ol') {\n   122→        if (inList) result.push('</' + listType + '>');\n   123→        result.push('<ol>');\n   124→        inList = true;\n   125→        listType = 'ol';\n   126→      }\n   127→      result.push('<li>' + content + '</li>');\n   128→    }\n   129→    // End of list\n   130→    else {\n   131→      if (inList && line.trim() === '') {\n   132→        result.push('</' + listType + '>');\n   133→        inList = false;\n   134→        listType = '';\n   135→      }\n   136→      result.push(line);\n   137→    }\n   138→  }\n   139→\n   140→  if (inList) {\n   141→    result.push('</' + listType + '>');\n   142→  }\n   143→\n   144→  html = result.join('\\n');\n   145→\n   146→  // Paragraphs\n   147→  const blocks = html.split(/\\n\\n+/);\n   148→  html = blocks.map(block => {\n   149→    block = block.trim();\n   150→    if (block && !block.match(/^<(h[1-6]|ul|ol|li|blockquote|pre|hr|div|p|__CODE_BLOCK_)/)) {\n   151→      return '<p>' + block.replace(/\\n/g, ' ') + '</p>';\n   152→    }\n   153→    return block;\n   154→  }).filter(b => b).join('\\n\\n');\n   155→\n   156→  // Restore code blocks\n   157→  codeBlocks.forEach((code, i) => {\n   158→    html = html.replace(`__CODE_BLOCK_${i}__`, code);\n   159→  });\n   160→\n   161→  return html;\n   162→}\n   163→\n   164→function escapeHtml(text) {\n   165→  const map = {\n   166→    '&': '&amp;',\n   167→    '<': '&lt;',\n   168→    '>': '&gt;',\n   169→    '\"': '&quot;',\n   170→    \"'\": '&#039;'\n   171→  };\n   172→  return text.replace(/[&<>\"']/g, m => map[m]);\n   173→}\n   174→\n   175→function generateSlug(filename) {\n   176→  return filename.replace(/\\.md$/, '').toLowerCase();\n   177→}\n   178→\n   179→function generateExcerpt(content, maxLength = 150) {\n   180→  const plainText = content.replace(/<[^>]*>/g, '').replace(/\\n+/g, ' ').trim();\n   181→  if (plainText.length <= maxLength) return plainText;\n   182→  return plainText.substring(0, maxLength).trim() + '...';\n   183→}\n   184→\n   185→function estimateReadTime(content) {\n   186→  const wordsPerMinute = 200;\n   187→  const words = content.split(/\\s+/).length;\n   188→  const minutes = Math.ceil(words / wordsPerMinute);\n   189→  return `${minutes} min read`;\n   190→}\n   191→\n   192→async function buildBlog() {\n   193→  console.log('Building blog data...');\n   194→\n   195→  // Check if content directory exists\n   196→  if (!fs.existsSync(contentDir)) {\n   197→    console.log('No blog content found. Creating directory...');\n   198→    fs.mkdirSync(contentDir, { recursive: true });\n   199→    return;\n   200→  }\n   201→\n   202→  const files = fs.readdirSync(contentDir).filter(file => file.endsWith('.md'));\n   203→\n   204→  const posts = [];\n   205→\n   206→  for (const file of files) {\n   207→    const filePath = path.join(contentDir, file);\n   208→    const fileContent = fs.readFileSync(filePath, 'utf-8');\n   209→    const { frontmatter, content } = parseFrontmatter(fileContent);\n   210→\n   211→    const html = markdownToHtml(content);\n   212→    const slug = frontmatter.slug || generateSlug(file);\n   213→    const excerpt = frontmatter.description || generateExcerpt(content);\n   214→    const readTime = frontmatter.readTime || estimateReadTime(content);\n   215→\n   216→    posts.push({\n   217→      slug,\n   218→      title: frontmatter.title,\n   219→      description: excerpt,\n   220→      date: frontmatter.date,\n   221→      author: frontmatter.author || 'Site Team',\n   222→      tags: Array.isArray(frontmatter.tags) ? frontmatter.tags : (frontmatter.tags ? [frontmatter.tags] : []),\n   223→      keywords: frontmatter.keywords || '',\n   224→      image: frontmatter.image || '/images/blog/default.jpg',\n   225→      readTime,\n   226→      featured: frontmatter.featured === 'true' || frontmatter.featured === true,\n   227→      published: frontmatter.published !== 'false' && frontmatter.published !== false,\n   228→      content: html\n   229→    });\n   230→  }\n   231→\n   232→  // Sort posts by date (newest first)\n   233→  posts.sort((a, b) => new Date(b.date) - new Date(a.date));\n   234→\n   235→  // Write posts data\n   236→  fs.writeFileSync(\n   237→    path.join(outputDir, 'posts.json'),\n   238→    JSON.stringify(posts, null, 2)\n   239→  );\n   240→\n   241→  console.log(`Built ${posts.length} blog posts`);\n   242→\n   243→  // Generate RSS feed\n   244→  generateRSSFeed(posts);\n   245→\n   246→  // Generate sitemap entries\n   247→  generateSitemapEntries(posts);\n   248→}\n   249→\n   250→function generateRSSFeed(posts) {\n   251→  const rss = `<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n   252→<rss version=\"2.0\" xmlns:atom=\"http://www.w3.org/2005/Atom\">\n   253→  <channel>\n   254→    <title>Datetime.app Blog</title>\n   255→    <description>Expert insights on timezones, time management, and productivity</description>\n   256→    <link>https://datetime.app/blog</link>\n   257→    <atom:link href=\"https://datetime.app/blog/rss.xml\" rel=\"self\" type=\"application/rss+xml\"/>\n   258→    ${posts.filter(p => p.published).slice(0, 20).map(post => `\n   259→    <item>\n   260→      <title>${escapeXml(post.title)}</title>\n   261→      <description>${escapeXml(post.description)}</description>\n   262→      <link>https://datetime.app/blog/${post.slug}</link>\n   263→      <guid>https://datetime.app/blog/${post.slug}</guid>\n   264→      <pubDate>${new Date(post.date).toUTCString()}</pubDate>\n   265→    </item>`).join('')}\n   266→  </channel>\n   267→</rss>`;\n   268→\n   269→  fs.writeFileSync(path.join(outputDir, 'rss.xml'), rss);\n   270→  console.log('Generated RSS feed');\n   271→}\n   272→\n   273→function generateSitemapEntries(posts) {\n   274→  const entries = posts.filter(p => p.published).map(post => ({\n   275→    url: `/blog/${post.slug}`,\n   276→    lastmod: post.date,\n   277→    changefreq: 'monthly',\n   278→    priority: 0.7\n   279→  }));\n   280→\n   281→  entries.unshift({\n   282→    url: '/blog',\n   283→    lastmod: new Date().toISOString().split('T')[0],\n   284→    changefreq: 'weekly',\n   285→    priority: 0.8\n   286→  });\n   287→\n   288→  fs.writeFileSync(\n   289→    path.join(outputDir, 'sitemap-entries.json'),\n   290→    JSON.stringify(entries, null, 2)\n   291→  );\n   292→  console.log('Generated sitemap entries');\n   293→}\n   294→\n   295→function escapeXml(text) {\n   296→  return text\n   297→    .replace(/&/g, '&amp;')\n   298→    .replace(/</g, '&lt;')\n   299→    .replace(/>/g, '&gt;')\n   300→    .replace(/\"/g, '&quot;')\n   301→    .replace(/'/g, '&apos;');\n   302→}\n   303→\n   304→// Run the build\n   305→buildBlog().catch(console.error);\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"99d7cc46-8cec-4e6d-92ef-e02e008c6f1c","uuid":"a4e23364-0e7e-449b-8865-0992772376dd","tool_use_result":{"type":"text","file":{"filePath":"/Users/airyland/workspace/becool/datetime/scripts/build-blog.js","content":"const fs = require('fs');\nconst path = require('path');\n\nconst contentDir = path.join(process.cwd(), 'content', 'blog');\nconst outputDir = path.join(process.cwd(), 'data', 'blog');\n\n// Ensure output directory exists\nif (!fs.existsSync(outputDir)) {\n  fs.mkdirSync(outputDir, { recursive: true });\n}\n\n// Simple frontmatter parser\nfunction parseFrontmatter(content) {\n  const lines = content.split('\\n');\n  const frontmatter = {};\n  let inFrontmatter = false;\n  let contentStartIndex = 0;\n\n  for (let i = 0; i < lines.length; i++) {\n    const line = lines[i];\n\n    if (i === 0 && line === '---') {\n      inFrontmatter = true;\n      continue;\n    }\n\n    if (inFrontmatter && line === '---') {\n      contentStartIndex = i + 1;\n      break;\n    }\n\n    if (inFrontmatter) {\n      const match = line.match(/^(\\w+):\\s*(.*)$/);\n      if (match) {\n        const key = match[1];\n        let value = match[2].trim();\n\n        // Handle arrays (tags)\n        if (value.startsWith('[') && value.endsWith(']')) {\n          value = value.slice(1, -1).split(',').map(v => v.trim().replace(/[\"']/g, ''));\n        } else {\n          // Remove quotes if present\n          value = value.replace(/^[\"']|[\"']$/g, '');\n        }\n\n        frontmatter[key] = value;\n      }\n    }\n  }\n\n  const markdownContent = lines.slice(contentStartIndex).join('\\n');\n  return { frontmatter, content: markdownContent };\n}\n\n// Improved markdown to HTML converter\nfunction markdownToHtml(markdown) {\n  let html = markdown;\n\n  // Preserve code blocks first\n  const codeBlocks = [];\n  html = html.replace(/```([\\s\\S]*?)```/g, (match, code) => {\n    const placeholder = `__CODE_BLOCK_${codeBlocks.length}__`;\n    codeBlocks.push('<pre><code>' + escapeHtml(code.trim()) + '</code></pre>');\n    return placeholder;\n  });\n\n  // Inline code\n  html = html.replace(/`([^`]+)`/g, '<code>$1</code>');\n\n  // Headers (shift levels: # becomes h2, ## becomes h3, etc.)\n  html = html.replace(/^###### (.*?)$/gm, '<h6>$1</h6>');\n  html = html.replace(/^##### (.*?)$/gm, '<h6>$1</h6>');\n  html = html.replace(/^#### (.*?)$/gm, '<h5>$1</h5>');\n  html = html.replace(/^### (.*?)$/gm, '<h4>$1</h4>');\n  html = html.replace(/^## (.*?)$/gm, '<h3>$1</h3>');\n  html = html.replace(/^# (.*?)$/gm, '<h2>$1</h2>');\n\n  // Blockquotes\n  html = html.replace(/^> (.*?)$/gm, '<blockquote>$1</blockquote>');\n\n  // Bold and italic\n  html = html.replace(/\\*\\*\\*(.*?)\\*\\*\\*/g, '<strong><em>$1</em></strong>');\n  html = html.replace(/\\*\\*(.*?)\\*\\*/g, '<strong>$1</strong>');\n  html = html.replace(/\\*(.*?)\\*/g, '<em>$1</em>');\n\n  // Links (add nofollow to external links)\n  html = html.replace(/\\[([^\\]]+)\\]\\(([^)]+)\\)/g, (match, text, url) => {\n    // Check if it's an external link (not starting with / or #)\n    const isExternal = !url.startsWith('/') && !url.startsWith('#') && !url.includes('datetime.app');\n    const rel = isExternal ? ' rel=\"nofollow noopener\" target=\"_blank\"' : '';\n    return `<a href=\"${url}\"${rel}>${text}</a>`;\n  });\n\n  // Horizontal rules\n  html = html.replace(/^---$/gm, '<hr>');\n  html = html.replace(/^\\*\\*\\*$/gm, '<hr>');\n\n  // Process lists properly\n  const lines = html.split('\\n');\n  let result = [];\n  let inList = false;\n  let listType = '';\n\n  for (let i = 0; i < lines.length; i++) {\n    let line = lines[i];\n\n    // Unordered list\n    if (line.match(/^[\\*\\-] (.+)$/)) {\n      const content = line.replace(/^[\\*\\-] (.+)$/, '$1');\n      if (!inList || listType !== 'ul') {\n        if (inList) result.push('</' + listType + '>');\n        result.push('<ul>');\n        inList = true;\n        listType = 'ul';\n      }\n      result.push('<li>' + content + '</li>');\n    }\n    // Ordered list\n    else if (line.match(/^\\d+\\. (.+)$/)) {\n      const content = line.replace(/^\\d+\\. (.+)$/, '$1');\n      if (!inList || listType !== 'ol') {\n        if (inList) result.push('</' + listType + '>');\n        result.push('<ol>');\n        inList = true;\n        listType = 'ol';\n      }\n      result.push('<li>' + content + '</li>');\n    }\n    // End of list\n    else {\n      if (inList && line.trim() === '') {\n        result.push('</' + listType + '>');\n        inList = false;\n        listType = '';\n      }\n      result.push(line);\n    }\n  }\n\n  if (inList) {\n    result.push('</' + listType + '>');\n  }\n\n  html = result.join('\\n');\n\n  // Paragraphs\n  const blocks = html.split(/\\n\\n+/);\n  html = blocks.map(block => {\n    block = block.trim();\n    if (block && !block.match(/^<(h[1-6]|ul|ol|li|blockquote|pre|hr|div|p|__CODE_BLOCK_)/)) {\n      return '<p>' + block.replace(/\\n/g, ' ') + '</p>';\n    }\n    return block;\n  }).filter(b => b).join('\\n\\n');\n\n  // Restore code blocks\n  codeBlocks.forEach((code, i) => {\n    html = html.replace(`__CODE_BLOCK_${i}__`, code);\n  });\n\n  return html;\n}\n\nfunction escapeHtml(text) {\n  const map = {\n    '&': '&amp;',\n    '<': '&lt;',\n    '>': '&gt;',\n    '\"': '&quot;',\n    \"'\": '&#039;'\n  };\n  return text.replace(/[&<>\"']/g, m => map[m]);\n}\n\nfunction generateSlug(filename) {\n  return filename.replace(/\\.md$/, '').toLowerCase();\n}\n\nfunction generateExcerpt(content, maxLength = 150) {\n  const plainText = content.replace(/<[^>]*>/g, '').replace(/\\n+/g, ' ').trim();\n  if (plainText.length <= maxLength) return plainText;\n  return plainText.substring(0, maxLength).trim() + '...';\n}\n\nfunction estimateReadTime(content) {\n  const wordsPerMinute = 200;\n  const words = content.split(/\\s+/).length;\n  const minutes = Math.ceil(words / wordsPerMinute);\n  return `${minutes} min read`;\n}\n\nasync function buildBlog() {\n  console.log('Building blog data...');\n\n  // Check if content directory exists\n  if (!fs.existsSync(contentDir)) {\n    console.log('No blog content found. Creating directory...');\n    fs.mkdirSync(contentDir, { recursive: true });\n    return;\n  }\n\n  const files = fs.readdirSync(contentDir).filter(file => file.endsWith('.md'));\n\n  const posts = [];\n\n  for (const file of files) {\n    const filePath = path.join(contentDir, file);\n    const fileContent = fs.readFileSync(filePath, 'utf-8');\n    const { frontmatter, content } = parseFrontmatter(fileContent);\n\n    const html = markdownToHtml(content);\n    const slug = frontmatter.slug || generateSlug(file);\n    const excerpt = frontmatter.description || generateExcerpt(content);\n    const readTime = frontmatter.readTime || estimateReadTime(content);\n\n    posts.push({\n      slug,\n      title: frontmatter.title,\n      description: excerpt,\n      date: frontmatter.date,\n      author: frontmatter.author || 'Site Team',\n      tags: Array.isArray(frontmatter.tags) ? frontmatter.tags : (frontmatter.tags ? [frontmatter.tags] : []),\n      keywords: frontmatter.keywords || '',\n      image: frontmatter.image || '/images/blog/default.jpg',\n      readTime,\n      featured: frontmatter.featured === 'true' || frontmatter.featured === true,\n      published: frontmatter.published !== 'false' && frontmatter.published !== false,\n      content: html\n    });\n  }\n\n  // Sort posts by date (newest first)\n  posts.sort((a, b) => new Date(b.date) - new Date(a.date));\n\n  // Write posts data\n  fs.writeFileSync(\n    path.join(outputDir, 'posts.json'),\n    JSON.stringify(posts, null, 2)\n  );\n\n  console.log(`Built ${posts.length} blog posts`);\n\n  // Generate RSS feed\n  generateRSSFeed(posts);\n\n  // Generate sitemap entries\n  generateSitemapEntries(posts);\n}\n\nfunction generateRSSFeed(posts) {\n  const rss = `<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<rss version=\"2.0\" xmlns:atom=\"http://www.w3.org/2005/Atom\">\n  <channel>\n    <title>Datetime.app Blog</title>\n    <description>Expert insights on timezones, time management, and productivity</description>\n    <link>https://datetime.app/blog</link>\n    <atom:link href=\"https://datetime.app/blog/rss.xml\" rel=\"self\" type=\"application/rss+xml\"/>\n    ${posts.filter(p => p.published).slice(0, 20).map(post => `\n    <item>\n      <title>${escapeXml(post.title)}</title>\n      <description>${escapeXml(post.description)}</description>\n      <link>https://datetime.app/blog/${post.slug}</link>\n      <guid>https://datetime.app/blog/${post.slug}</guid>\n      <pubDate>${new Date(post.date).toUTCString()}</pubDate>\n    </item>`).join('')}\n  </channel>\n</rss>`;\n\n  fs.writeFileSync(path.join(outputDir, 'rss.xml'), rss);\n  console.log('Generated RSS feed');\n}\n\nfunction generateSitemapEntries(posts) {\n  const entries = posts.filter(p => p.published).map(post => ({\n    url: `/blog/${post.slug}`,\n    lastmod: post.date,\n    changefreq: 'monthly',\n    priority: 0.7\n  }));\n\n  entries.unshift({\n    url: '/blog',\n    lastmod: new Date().toISOString().split('T')[0],\n    changefreq: 'weekly',\n    priority: 0.8\n  });\n\n  fs.writeFileSync(\n    path.join(outputDir, 'sitemap-entries.json'),\n    JSON.stringify(entries, null, 2)\n  );\n  console.log('Generated sitemap entries');\n}\n\nfunction escapeXml(text) {\n  return text\n    .replace(/&/g, '&amp;')\n    .replace(/</g, '&lt;')\n    .replace(/>/g, '&gt;')\n    .replace(/\"/g, '&quot;')\n    .replace(/'/g, '&apos;');\n}\n\n// Run the build\nbuildBlog().catch(console.error);","numLines":305,"startLine":1,"totalLines":305}}}
