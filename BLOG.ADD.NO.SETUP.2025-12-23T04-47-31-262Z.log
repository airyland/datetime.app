    56→function markdownToHtml(markdown) {\n    57→  let html = markdown;\n    58→\n    59→  // Preserve code blocks first\n    60→  const codeBlocks = [];\n    61→  html = html.replace(/```([\\s\\S]*?)```/g, (match, code) => {\n    62→    const placeholder = `__CODE_BLOCK_${codeBlocks.length}__`;\n    63→    codeBlocks.push('<pre><code>' + escapeHtml(code.trim()) + '</code></pre>');\n    64→    return placeholder;\n    65→  });\n    66→\n    67→  // Inline code\n    68→  html = html.replace(/`([^`]+)`/g, '<code>$1</code>');\n    69→\n    70→  // Headers (shift levels: # becomes h2, ## becomes h3, etc.)\n    71→  html = html.replace(/^###### (.*?)$/gm, '<h6>$1</h6>');\n    72→  html = html.replace(/^##### (.*?)$/gm, '<h6>$1</h6>');\n    73→  html = html.replace(/^#### (.*?)$/gm, '<h5>$1</h5>');\n    74→  html = html.replace(/^### (.*?)$/gm, '<h4>$1</h4>');\n    75→  html = html.replace(/^## (.*?)$/gm, '<h3>$1</h3>');\n    76→  html = html.replace(/^# (.*?)$/gm, '<h2>$1</h2>');\n    77→\n    78→  // Blockquotes\n    79→  html = html.replace(/^> (.*?)$/gm, '<blockquote>$1</blockquote>');\n    80→\n    81→  // Bold and italic\n    82→  html = html.replace(/\\*\\*\\*(.*?)\\*\\*\\*/g, '<strong><em>$1</em></strong>');\n    83→  html = html.replace(/\\*\\*(.*?)\\*\\*/g, '<strong>$1</strong>');\n    84→  html = html.replace(/\\*(.*?)\\*/g, '<em>$1</em>');\n    85→\n    86→  // Links (add nofollow to external links)\n    87→  html = html.replace(/\\[([^\\]]+)\\]\\(([^)]+)\\)/g, (match, text, url) => {\n    88→    // Check if it's an external link (not starting with / or #)\n    89→    const isExternal = !url.startsWith('/') && !url.startsWith('#') && !url.includes('datetime.app');\n    90→    const rel = isExternal ? ' rel=\"nofollow noopener\" target=\"_blank\"' : '';\n    91→    return `<a href=\"${url}\"${rel}>${text}</a>`;\n    92→  });\n    93→\n    94→  // Horizontal rules (but not table separators)\n    95→  html = html.replace(/^---$/gm, '<hr>');\n    96→  html = html.replace(/^\\*\\*\\*$/gm, '<hr>');\n    97→\n    98→  // Process tables and lists\n    99→  const lines = html.split('\\n');\n   100→  let result = [];\n   101→  let inList = false;\n   102→  let listType = '';\n   103→  let inTable = false;\n   104→  let tableRows = [];\n   105→\n   106→  for (let i = 0; i < lines.length; i++) {\n   107→    let line = lines[i];\n   108→\n   109→    // Table detection\n   110→    if (line.match(/^\\|(.+)\\|$/)) {\n   111→      // Check if it's a separator line (contains only |, -, :, and spaces)\n   112→      // A separator line has cells that only contain -, :, and spaces\n   113→      const cells = line.split('|').slice(1, -1);\n   114→      const isSeparator = cells.every(cell => /^[\\s\\-:]+$/.test(cell));\n   115→\n   116→      if (!inTable && !isSeparator) {\n   117→        // Start of table\n   118→        inTable = true;\n   119→        tableRows = [];\n   120→      }\n   121→\n   122→      if (inTable) {\n   123→        if (!isSeparator) {\n   124→          // Parse table row\n   125→          const parsedCells = cells.map(cell => cell.trim());\n   126→          tableRows.push(parsedCells);\n   127→        }\n   128→\n   129→        // Check if next line is not a table row (end of table)\n   130→        if (i + 1 >= lines.length || !lines[i + 1].match(/^\\|(.+)\\|$/)) {\n   131→          // Build HTML table\n   132→          let tableHtml = '<table>\\n';\n   133→\n   134→          if (tableRows.length > 0) {\n   135→            // First row is header\n   136→            tableHtml += '<thead>\\n<tr>\\n';\n   137→            tableRows[0].forEach(cell => {\n   138→              tableHtml += `<th>${cell}</th>\\n`;\n   139→            });\n   140→            tableHtml += '</tr>\\n</thead>\\n';\n   141→\n   142→            // Remaining rows are body\n   143→            if (tableRows.length > 1) {\n   144→              tableHtml += '<tbody>\\n';\n   145→              for (let j = 1; j < tableRows.length; j++) {\n   146→                tableHtml += '<tr>\\n';\n   147→                tableRows[j].forEach(cell => {\n   148→                  tableHtml += `<td>${cell}</td>\\n`;\n   149→                });\n   150→                tableHtml += '</tr>\\n';\n   151→              }\n   152→              tableHtml += '</tbody>\\n';\n   153→            }\n   154→          }\n   155→\n   156→          tableHtml += '</table>';\n   157→          result.push(tableHtml);\n   158→\n   159→          inTable = false;\n   160→          tableRows = [];\n   161→        }\n   162→        continue;\n   163→      }\n   164→    }\n   165→\n   166→    // Unordered list\n   167→    if (line.match(/^[\\*\\-] (.+)$/)) {\n   168→      const content = line.replace(/^[\\*\\-] (.+)$/, '$1');\n   169→      if (!inList || listType !== 'ul') {\n   170→        if (inList) result.push('</' + listType + '>');\n   171→        result.push('<ul>');\n   172→        inList = true;\n   173→        listType = 'ul';\n   174→      }\n   175→      result.push('<li>' + content + '</li>');\n   176→    }\n   177→    // Ordered list\n   178→    else if (line.match(/^\\d+\\. (.+)$/)) {\n   179→      const content = line.replace(/^\\d+\\. (.+)$/, '$1');\n   180→      if (!inList || listType !== 'ol') {\n   181→        if (inList) result.push('</' + listType + '>');\n   182→        result.push('<ol>');\n   183→        inList = true;\n   184→        listType = 'ol';\n   185→      }\n   186→      result.push('<li>' + content + '</li>');\n   187→    }\n   188→    // End of list\n   189→    else {\n   190→      if (inList && line.trim() === '') {\n   191→        result.push('</' + listType + '>');\n   192→        inList = false;\n   193→        listType = '';\n   194→      }\n   195→      result.push(line);\n   196→    }\n   197→  }\n   198→\n   199→  if (inList) {\n   200→    result.push('</' + listType + '>');\n   201→  }\n   202→\n   203→  html = result.join('\\n');\n   204→\n   205→  // Paragraphs\n   206→  const blocks = html.split(/\\n\\n+/);\n   207→  html = blocks.map(block => {\n   208→    block = block.trim();\n   209→    if (block && !block.match(/^<(h[1-6]|ul|ol|li|blockquote|pre|hr|div|p|table|__CODE_BLOCK_)/)) {\n   210→      return '<p>' + block.replace(/\\n/g, ' ') + '</p>';\n   211→    }\n   212→    return block;\n   213→  }).filter(b => b).join('\\n\\n');\n   214→\n   215→  // Restore code blocks\n   216→  codeBlocks.forEach((code, i) => {\n   217→    html = html.replace(`__CODE_BLOCK_${i}__`, code);\n   218→  });\n   219→\n   220→  return html;\n   221→}\n   222→\n   223→function escapeHtml(text) {\n   224→  const map = {\n   225→    '&': '&amp;',\n   226→    '<': '&lt;',\n   227→    '>': '&gt;',\n   228→    '\"': '&quot;',\n   229→    \"'\": '&#039;'\n   230→  };\n   231→  return text.replace(/[&<>\"']/g, m => map[m]);\n   232→}\n   233→\n   234→function generateSlug(filename) {\n   235→  return filename.replace(/\\.md$/, '').toLowerCase();\n   236→}\n   237→\n   238→function generateExcerpt(content, maxLength = 150) {\n   239→  const plainText = content.replace(/<[^>]*>/g, '').replace(/\\n+/g, ' ').trim();\n   240→  if (plainText.length <= maxLength) return plainText;\n   241→  return plainText.substring(0, maxLength).trim() + '...';\n   242→}\n   243→\n   244→function estimateReadTime(content) {\n   245→  const wordsPerMinute = 200;\n   246→  const words = content.split(/\\s+/).length;\n   247→  const minutes = Math.ceil(words / wordsPerMinute);\n   248→  return `${minutes} min read`;\n   249→}\n   250→\n   251→async function buildBlog() {\n   252→  console.log('Building blog data...');\n   253→\n   254→  // Check if content directory exists\n   255→  if (!fs.existsSync(contentDir)) {\n   256→    console.log('No blog content found. Creating directory...');\n   257→    fs.mkdirSync(contentDir, { recursive: true });\n   258→    return;\n   259→  }\n   260→\n   261→  const files = fs.readdirSync(contentDir).filter(file => file.endsWith('.md'));\n   262→\n   263→  const posts = [];\n   264→\n   265→  for (const file of files) {\n   266→    const filePath = path.join(contentDir, file);\n   267→    const fileContent = fs.readFileSync(filePath, 'utf-8');\n   268→    const { frontmatter, content } = parseFrontmatter(fileContent);\n   269→\n   270→    const html = markdownToHtml(content);\n   271→    const slug = frontmatter.slug || generateSlug(file);\n   272→    const excerpt = frontmatter.description || generateExcerpt(content);\n   273→    const readTime = frontmatter.readTime || estimateReadTime(content);\n   274→\n   275→    posts.push({\n   276→      slug,\n   277→      title: frontmatter.title,\n   278→      description: excerpt,\n   279→      date: frontmatter.date,\n   280→      author: frontmatter.author || 'Site Team',\n   281→      tags: Array.isArray(frontmatter.tags) ? frontmatter.tags : (frontmatter.tags ? [frontmatter.tags] : []),\n   282→      keywords: frontmatter.keywords || '',\n   283→      image: frontmatter.image || '/images/blog/default.jpg',\n   284→      readTime,\n   285→      featured: frontmatter.featured === 'true' || frontmatter.featured === true,\n   286→      published: frontmatter.published !== 'false' && frontmatter.published !== false,\n   287→      content: html\n   288→    });\n   289→  }\n   290→\n   291→  // Sort posts by date (newest first)\n   292→  posts.sort((a, b) => new Date(b.date) - new Date(a.date));\n   293→\n   294→  // Write posts data\n   295→  fs.writeFileSync(\n   296→    path.join(outputDir, 'posts.json'),\n   297→    JSON.stringify(posts, null, 2)\n   298→  );\n   299→\n   300→  console.log(`Built ${posts.length} blog posts`);\n   301→\n   302→  // Generate RSS feed\n   303→  generateRSSFeed(posts);\n   304→\n   305→  // Generate sitemap entries\n   306→  generateSitemapEntries(posts);\n   307→}\n   308→\n   309→function generateRSSFeed(posts) {\n   310→  const rss = `<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n   311→<rss version=\"2.0\" xmlns:atom=\"http://www.w3.org/2005/Atom\">\n   312→  <channel>\n   313→    <title>Datetime.app Blog</title>\n   314→    <description>Expert insights on timezones, time management, and productivity</description>\n   315→    <link>https://datetime.app/blog</link>\n   316→    <atom:link href=\"https://datetime.app/blog/rss.xml\" rel=\"self\" type=\"application/rss+xml\"/>\n   317→    ${posts.filter(p => p.published).slice(0, 20).map(post => `\n   318→    <item>\n   319→      <title>${escapeXml(post.title)}</title>\n   320→      <description>${escapeXml(post.description)}</description>\n   321→      <link>https://datetime.app/blog/${post.slug}</link>\n   322→      <guid>https://datetime.app/blog/${post.slug}</guid>\n   323→      <pubDate>${new Date(post.date).toUTCString()}</pubDate>\n   324→    </item>`).join('')}\n   325→  </channel>\n   326→</rss>`;\n   327→\n   328→  fs.writeFileSync(path.join(outputDir, 'rss.xml'), rss);\n   329→  console.log('Generated RSS feed');\n   330→}\n   331→\n   332→function generateSitemapEntries(posts) {\n   333→  const entries = posts.filter(p => p.published).map(post => ({\n   334→    url: `/blog/${post.slug}`,\n   335→    lastmod: post.date,\n   336→    changefreq: 'monthly',\n   337→    priority: 0.7\n   338→  }));\n   339→\n   340→  entries.unshift({\n   341→    url: '/blog',\n   342→    lastmod: new Date().toISOString().split('T')[0],\n   343→    changefreq: 'weekly',\n   344→    priority: 0.8\n   345→  });\n   346→\n   347→  fs.writeFileSync(\n   348→    path.join(outputDir, 'sitemap-entries.json'),\n   349→    JSON.stringify(entries, null, 2)\n   350→  );\n   351→  console.log('Generated sitemap entries');\n   352→}\n   353→\n   354→function escapeXml(text) {\n   355→  return text\n   356→    .replace(/&/g, '&amp;')\n   357→    .replace(/</g, '&lt;')\n   358→    .replace(/>/g, '&gt;')\n   359→    .replace(/\"/g, '&quot;')\n   360→    .replace(/'/g, '&apos;');\n   361→}\n   362→\n   363→// Run the build\n   364→buildBlog().catch(console.error);\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"dbddee86-a9a5-40ab-8589-fd51456e97f2","uuid":"c248229e-2f36-4f60-997e-071f480ffd23","tool_use_result":{"type":"text","file":{"filePath":"/Users/airyland/workspace/becool/datetime/scripts/build-blog.js","content":"const fs = require('fs');\nconst path = require('path');\n\nconst contentDir = path.join(process.cwd(), 'content', 'blog');\nconst outputDir = path.join(process.cwd(), 'data', 'blog');\n\n// Ensure output directory exists\nif (!fs.existsSync(outputDir)) {\n  fs.mkdirSync(outputDir, { recursive: true });\n}\n\n// Simple frontmatter parser\nfunction parseFrontmatter(content) {\n  const lines = content.split('\\n');\n  const frontmatter = {};\n  let inFrontmatter = false;\n  let contentStartIndex = 0;\n\n  for (let i = 0; i < lines.length; i++) {\n    const line = lines[i];\n\n    if (i === 0 && line === '---') {\n      inFrontmatter = true;\n      continue;\n    }\n\n    if (inFrontmatter && line === '---') {\n      contentStartIndex = i + 1;\n      break;\n    }\n\n    if (inFrontmatter) {\n      const match = line.match(/^(\\w+):\\s*(.*)$/);\n      if (match) {\n        const key = match[1];\n        let value = match[2].trim();\n\n        // Handle arrays (tags)\n        if (value.startsWith('[') && value.endsWith(']')) {\n          value = value.slice(1, -1).split(',').map(v => v.trim().replace(/[\"']/g, ''));\n        } else {\n          // Remove quotes if present\n          value = value.replace(/^[\"']|[\"']$/g, '');\n        }\n\n        frontmatter[key] = value;\n      }\n    }\n  }\n\n  const markdownContent = lines.slice(contentStartIndex).join('\\n');\n  return { frontmatter, content: markdownContent };\n}\n\n// Improved markdown to HTML converter\nfunction markdownToHtml(markdown) {\n  let html = markdown;\n\n  // Preserve code blocks first\n  const codeBlocks = [];\n  html = html.replace(/```([\\s\\S]*?)```/g, (match, code) => {\n    const placeholder = `__CODE_BLOCK_${codeBlocks.length}__`;\n    codeBlocks.push('<pre><code>' + escapeHtml(code.trim()) + '</code></pre>');\n    return placeholder;\n  });\n\n  // Inline code\n  html = html.replace(/`([^`]+)`/g, '<code>$1</code>');\n\n  // Headers (shift levels: # becomes h2, ## becomes h3, etc.)\n  html = html.replace(/^###### (.*?)$/gm, '<h6>$1</h6>');\n  html = html.replace(/^##### (.*?)$/gm, '<h6>$1</h6>');\n  html = html.replace(/^#### (.*?)$/gm, '<h5>$1</h5>');\n  html = html.replace(/^### (.*?)$/gm, '<h4>$1</h4>');\n  html = html.replace(/^## (.*?)$/gm, '<h3>$1</h3>');\n  html = html.replace(/^# (.*?)$/gm, '<h2>$1</h2>');\n\n  // Blockquotes\n  html = html.replace(/^> (.*?)$/gm, '<blockquote>$1</blockquote>');\n\n  // Bold and italic\n  html = html.replace(/\\*\\*\\*(.*?)\\*\\*\\*/g, '<strong><em>$1</em></strong>');\n  html = html.replace(/\\*\\*(.*?)\\*\\*/g, '<strong>$1</strong>');\n  html = html.replace(/\\*(.*?)\\*/g, '<em>$1</em>');\n\n  // Links (add nofollow to external links)\n  html = html.replace(/\\[([^\\]]+)\\]\\(([^)]+)\\)/g, (match, text, url) => {\n    // Check if it's an external link (not starting with / or #)\n    const isExternal = !url.startsWith('/') && !url.startsWith('#') && !url.includes('datetime.app');\n    const rel = isExternal ? ' rel=\"nofollow noopener\" target=\"_blank\"' : '';\n    return `<a href=\"${url}\"${rel}>${text}</a>`;\n  });\n\n  // Horizontal rules (but not table separators)\n  html = html.replace(/^---$/gm, '<hr>');\n  html = html.replace(/^\\*\\*\\*$/gm, '<hr>');\n\n  // Process tables and lists\n  const lines = html.split('\\n');\n  let result = [];\n  let inList = false;\n  let listType = '';\n  let inTable = false;\n  let tableRows = [];\n\n  for (let i = 0; i < lines.length; i++) {\n    let line = lines[i];\n\n    // Table detection\n    if (line.match(/^\\|(.+)\\|$/)) {\n      // Check if it's a separator line (contains only |, -, :, and spaces)\n      // A separator line has cells that only contain -, :, and spaces\n      const cells = line.split('|').slice(1, -1);\n      const isSeparator = cells.every(cell => /^[\\s\\-:]+$/.test(cell));\n\n      if (!inTable && !isSeparator) {\n        // Start of table\n        inTable = true;\n        tableRows = [];\n      }\n\n      if (inTable) {\n        if (!isSeparator) {\n          // Parse table row\n          const parsedCells = cells.map(cell => cell.trim());\n          tableRows.push(parsedCells);\n        }\n\n        // Check if next line is not a table row (end of table)\n        if (i + 1 >= lines.length || !lines[i + 1].match(/^\\|(.+)\\|$/)) {\n          // Build HTML table\n          let tableHtml = '<table>\\n';\n\n          if (tableRows.length > 0) {\n            // First row is header\n            tableHtml += '<thead>\\n<tr>\\n';\n            tableRows[0].forEach(cell => {\n              tableHtml += `<th>${cell}</th>\\n`;\n            });\n            tableHtml += '</tr>\\n</thead>\\n';\n\n            // Remaining rows are body\n            if (tableRows.length > 1) {\n              tableHtml += '<tbody>\\n';\n              for (let j = 1; j < tableRows.length; j++) {\n                tableHtml += '<tr>\\n';\n                tableRows[j].forEach(cell => {\n                  tableHtml += `<td>${cell}</td>\\n`;\n                });\n                tableHtml += '</tr>\\n';\n              }\n              tableHtml += '</tbody>\\n';\n            }\n          }\n\n          tableHtml += '</table>';\n          result.push(tableHtml);\n\n          inTable = false;\n          tableRows = [];\n        }\n        continue;\n      }\n    }\n\n    // Unordered list\n    if (line.match(/^[\\*\\-] (.+)$/)) {\n      const content = line.replace(/^[\\*\\-] (.+)$/, '$1');\n      if (!inList || listType !== 'ul') {\n        if (inList) result.push('</' + listType + '>');\n        result.push('<ul>');\n        inList = true;\n        listType = 'ul';\n      }\n      result.push('<li>' + content + '</li>');\n    }\n    // Ordered list\n    else if (line.match(/^\\d+\\. (.+)$/)) {\n      const content = line.replace(/^\\d+\\. (.+)$/, '$1');\n      if (!inList || listType !== 'ol') {\n        if (inList) result.push('</' + listType + '>');\n        result.push('<ol>');\n        inList = true;\n        listType = 'ol';\n      }\n      result.push('<li>' + content + '</li>');\n    }\n    // End of list\n    else {\n      if (inList && line.trim() === '') {\n        result.push('</' + listType + '>');\n        inList = false;\n        listType = '';\n      }\n      result.push(line);\n    }\n  }\n\n  if (inList) {\n    result.push('</' + listType + '>');\n  }\n\n  html = result.join('\\n');\n\n  // Paragraphs\n  const blocks = html.split(/\\n\\n+/);\n  html = blocks.map(block => {\n    block = block.trim();\n    if (block && !block.match(/^<(h[1-6]|ul|ol|li|blockquote|pre|hr|div|p|table|__CODE_BLOCK_)/)) {\n      return '<p>' + block.replace(/\\n/g, ' ') + '</p>';\n    }\n    return block;\n  }).filter(b => b).join('\\n\\n');\n\n  // Restore code blocks\n  codeBlocks.forEach((code, i) => {\n    html = html.replace(`__CODE_BLOCK_${i}__`, code);\n  });\n\n  return html;\n}\n\nfunction escapeHtml(text) {\n  const map = {\n    '&': '&amp;',\n    '<': '&lt;',\n    '>': '&gt;',\n    '\"': '&quot;',\n    \"'\": '&#039;'\n  };\n  return text.replace(/[&<>\"']/g, m => map[m]);\n}\n\nfunction generateSlug(filename) {\n  return filename.replace(/\\.md$/, '').toLowerCase();\n}\n\nfunction generateExcerpt(content, maxLength = 150) {\n  const plainText = content.replace(/<[^>]*>/g, '').replace(/\\n+/g, ' ').trim();\n  if (plainText.length <= maxLength) return plainText;\n  return plainText.substring(0, maxLength).trim() + '...';\n}\n\nfunction estimateReadTime(content) {\n  const wordsPerMinute = 200;\n  const words = content.split(/\\s+/).length;\n  const minutes = Math.ceil(words / wordsPerMinute);\n  return `${minutes} min read`;\n}\n\nasync function buildBlog() {\n  console.log('Building blog data...');\n\n  // Check if content directory exists\n  if (!fs.existsSync(contentDir)) {\n    console.log('No blog content found. Creating directory...');\n    fs.mkdirSync(contentDir, { recursive: true });\n    return;\n  }\n\n  const files = fs.readdirSync(contentDir).filter(file => file.endsWith('.md'));\n\n  const posts = [];\n\n  for (const file of files) {\n    const filePath = path.join(contentDir, file);\n    const fileContent = fs.readFileSync(filePath, 'utf-8');\n    const { frontmatter, content } = parseFrontmatter(fileContent);\n\n    const html = markdownToHtml(content);\n    const slug = frontmatter.slug || generateSlug(file);\n    const excerpt = frontmatter.description || generateExcerpt(content);\n    const readTime = frontmatter.readTime || estimateReadTime(content);\n\n    posts.push({\n      slug,\n      title: frontmatter.title,\n      description: excerpt,\n      date: frontmatter.date,\n      author: frontmatter.author || 'Site Team',\n      tags: Array.isArray(frontmatter.tags) ? frontmatter.tags : (frontmatter.tags ? [frontmatter.tags] : []),\n      keywords: frontmatter.keywords || '',\n      image: frontmatter.image || '/images/blog/default.jpg',\n      readTime,\n      featured: frontmatter.featured === 'true' || frontmatter.featured === true,\n      published: frontmatter.published !== 'false' && frontmatter.published !== false,\n      content: html\n    });\n  }\n\n  // Sort posts by date (newest first)\n  posts.sort((a, b) => new Date(b.date) - new Date(a.date));\n\n  // Write posts data\n  fs.writeFileSync(\n    path.join(outputDir, 'posts.json'),\n    JSON.stringify(posts, null, 2)\n  );\n\n  console.log(`Built ${posts.length} blog posts`);\n\n  // Generate RSS feed\n  generateRSSFeed(posts);\n\n  // Generate sitemap entries\n  generateSitemapEntries(posts);\n}\n\nfunction generateRSSFeed(posts) {\n  const rss = `<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<rss version=\"2.0\" xmlns:atom=\"http://www.w3.org/2005/Atom\">\n  <channel>\n    <title>Datetime.app Blog</title>\n    <description>Expert insights on timezones, time management, and productivity</description>\n    <link>https://datetime.app/blog</link>\n    <atom:link href=\"https://datetime.app/blog/rss.xml\" rel=\"self\" type=\"application/rss+xml\"/>\n    ${posts.filter(p => p.published).slice(0, 20).map(post => `\n    <item>\n      <title>${escapeXml(post.title)}</title>\n      <description>${escapeXml(post.description)}</description>\n      <link>https://datetime.app/blog/${post.slug}</link>\n      <guid>https://datetime.app/blog/${post.slug}</guid>\n      <pubDate>${new Date(post.date).toUTCString()}</pubDate>\n    </item>`).join('')}\n  </channel>\n</rss>`;\n\n  fs.writeFileSync(path.join(outputDir, 'rss.xml'), rss);\n  console.log('Generated RSS feed');\n}\n\nfunction generateSitemapEntries(posts) {\n  const entries = posts.filter(p => p.published).map(post => ({\n    url: `/blog/${post.slug}`,\n    lastmod: post.date,\n    changefreq: 'monthly',\n    priority: 0.7\n  }));\n\n  entries.unshift({\n    url: '/blog',\n    lastmod: new Date().toISOString().split('T')[0],\n    changefreq: 'weekly',\n    priority: 0.8\n  });\n\n  fs.writeFileSync(\n    path.join(outputDir, 'sitemap-entries.json'),\n    JSON.stringify(entries, null, 2)\n  );\n  console.log('Generated sitemap entries');\n}\n\nfunction escapeXml(text) {\n  return text\n    .replace(/&/g, '&amp;')\n    .replace(/</g, '&lt;')\n    .replace(/>/g, '&gt;')\n    .replace(/\"/g, '&quot;')\n    .replace(/'/g, '&apos;');\n}\n\n// Run the build\nbuildBlog().catch(console.error);","numLines":364,"startLine":1,"totalLines":364}}}
